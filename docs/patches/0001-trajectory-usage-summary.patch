@@ -0,0 +1,109 @@
+/** Session-wide usage strip under the toolbar: cache hits, context occupancy,
+ * session tokens, and request count. It reads projections only, so it keeps
+ * working while the ledger itself is paged or filtered. */
+
+import type { ReactNode } from 'react'
+import type {
+  ContextPressureProjection, TokenUsageProjection,
+} from '@deepseek-ai/dsh-token-meter/client'
+import type { TrajectoryTranslate } from './locales.ts'
+import { cacheHitPercent } from './usage-metrics.ts'
+import css from './TrajectorySummary.module.css'
+
+/** Occupancy thresholds that recolor the percent reading. */
+const WARN_PERCENT = 75
+const ERROR_PERCENT = 90
+
+/**
+ * Compact token count for the strip.
+ * @param value - token count.
+ * @param t - trajectory locale seat.
+ * @returns Count using the locale's thousand or million unit when scaled.
+ */
+function compactTokens(value: number, t: TrajectoryTranslate): string {
+  const scaled = (candidate: number): string => candidate >= 100
+    ? String(Math.round(candidate))
+    : String(Math.round(candidate * 10) / 10)
+  if (value < 1_000) return String(value)
+  if (value < 1_000_000) return t('unit.thousand', { value: scaled(value / 1_000) })
+  return t('unit.million', { value: scaled(value / 1_000_000) })
+}
+
+/** One labelled reading in the strip. */
+function Metric({ label, children }: { label: string; children: ReactNode }) {
+  return (
+    <span className={css.metric}>
+      <span className={css.label}>{label}</span>
+      {children}
+    </span>
+  )
+}
+
+export interface TrajectorySummaryProps {
+  /** Cumulative provider usage across the complete session log. */
+  tokenUsage: TokenUsageProjection | undefined
+  /** Newest request pressure paired with the newest known capacity. */
+  pressure: ContextPressureProjection | undefined
+  /** Non-compaction requests recorded in the complete session log. */
+  requestCount: number
+  /** Trajectory locale seat. */
+  t: TrajectoryTranslate
+}
+
+export function TrajectorySummary({ tokenUsage, pressure, requestCount, t }: TrajectorySummaryProps) {
+  const usage = tokenUsage === undefined
+    ? undefined
+    : {
+      input: tokenUsage.uncachedInputTokens,
+      cacheRead: tokenUsage.cacheReadTokens,
+      cacheWrite: tokenUsage.cacheWriteTokens,
+    }
+  const hit = usage === undefined ? null : cacheHitPercent(usage)
+  const usedTokens = pressure?.projectedTokens ?? pressure?.pressureTokens
+  const percent = usedTokens === undefined || pressure?.contextWindow === undefined
+    ? null
+    : Math.min(100, Math.round(usedTokens / pressure.contextWindow * 100))
+  const level = percent === null
+    ? undefined
+    : percent >= ERROR_PERCENT ? 'error' : percent >= WARN_PERCENT ? 'warn' : undefined
+  const sessionTokens = tokenUsage === undefined
+    ? undefined
+    : tokenUsage.uncachedInputTokens + tokenUsage.cacheReadTokens
+      + tokenUsage.cacheWriteTokens + tokenUsage.outputTokens
+
+  if (hit === null && usedTokens === undefined && sessionTokens === undefined) return null
+
+  return (
+    <div className={css.root} role="group" aria-label={t('summary.aria')}>
+      <div className={css.inner}>
+        <Metric label={t('summary.cacheHit')}>
+          <span className={css.value}>
+            {hit === null ? t('summary.unavailable') : t('unit.percent', { value: hit })}
+          </span>
+        </Metric>
+        {usedTokens !== undefined && (
+          <Metric label={t('summary.context')}>
+            {percent !== null && (
+              <span className={css.percent} data-level={level}>
+                {t('unit.percent', { value: percent })}
+              </span>
+            )}
+            <span className={css.value}>
+              {pressure?.contextWindow === undefined
+                ? compactTokens(usedTokens, t)
+                : `${compactTokens(usedTokens, t)} / ${compactTokens(pressure.contextWindow, t)}`}
+            </span>
+          </Metric>
+        )}
+        {sessionTokens !== undefined && (
+          <Metric label={t('summary.tokens')}>
+            <span className={css.value}>{compactTokens(sessionTokens, t)}</span>
+          </Metric>
+        )}
+        <Metric label={t('summary.requests')}>
+          <span className={css.value}>{t('summary.requestsValue', { count: requestCount })}</span>
+        </Metric>
+      </div>
+    </div>
+  )
+}
