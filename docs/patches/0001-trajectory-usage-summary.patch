diff --git a/packages/client/ui-trajectory/src/client/usage-metrics.ts b/packages/client/ui-trajectory/src/client/usage-metrics.ts
new file mode 100644
index 00000000..ed2d776b
--- /dev/null
+++ b/packages/client/ui-trajectory/src/client/usage-metrics.ts
@@ -0,0 +1,33 @@
+/** Pure display metrics shared by the trajectory summary and usage panels. */
+
+/** Prompt-side buckets as reported by a provider for one request or a session. */
+export interface CacheUsageLike {
+  input?: number
+  cacheRead?: number
+  cacheWrite?: number
+}
+
+/**
+ * Prompt-side total of one usage sample.
+ * @param usage - provider-reported buckets.
+ * @returns uncached input plus cache reads and writes.
+ */
+export function promptTokens(usage: CacheUsageLike): number {
+  return Math.max(0, usage.input ?? 0)
+    + Math.max(0, usage.cacheRead ?? 0)
+    + Math.max(0, usage.cacheWrite ?? 0)
+}
+
+/**
+ * Display-ready cache-hit share, never rounding a partial hit up to 100.
+ * @param usage - provider-reported prompt buckets.
+ * @returns percentage text, or null when the sample has no prompt input.
+ */
+export function cacheHitPercent(usage: CacheUsageLike): string | null {
+  const prompt = promptTokens(usage)
+  if (prompt === 0) return null
+  const cached = Math.max(0, usage.cacheRead ?? 0)
+  if (cached === prompt) return '100'
+  const tenths = Math.min(999, Math.round(cached / prompt * 1_000))
+  return tenths % 10 === 0 ? String(tenths / 10) : (tenths / 10).toFixed(1)
+}
diff --git a/packages/client/ui-trajectory/tests/usage-metrics.spec.ts b/packages/client/ui-trajectory/tests/usage-metrics.spec.ts
new file mode 100644
index 00000000..ad600555
--- /dev/null
+++ b/packages/client/ui-trajectory/tests/usage-metrics.spec.ts
@@ -0,0 +1,39 @@
+import { describe, expect, it } from 'vitest'
+import { cacheHitPercent, promptTokens } from '../src/client/usage-metrics.ts'
+
+describe('promptTokens', () => {
+  it('sums the disjoint prompt buckets', () => {
+    expect(promptTokens({ input: 10, cacheRead: 80, cacheWrite: 5 })).toBe(95)
+  })
+
+  it('treats absent and negative buckets as zero', () => {
+    expect(promptTokens({})).toBe(0)
+    expect(promptTokens({ input: -4, cacheRead: 3 })).toBe(3)
+  })
+})
+
+describe('cacheHitPercent', () => {
+  it('returns null without prompt input', () => {
+    expect(cacheHitPercent({})).toBeNull()
+    expect(cacheHitPercent({ output: 12 } as never)).toBeNull()
+  })
+
+  it('reports a full hit as 100', () => {
+    expect(cacheHitPercent({ cacheRead: 64 })).toBe('100')
+    expect(cacheHitPercent({ input: 0, cacheRead: 64, cacheWrite: 0 })).toBe('100')
+  })
+
+  it('keeps an almost-full hit below 100', () => {
+    expect(cacheHitPercent({ cacheRead: 999, input: 1 })).toBe('99.9')
+    expect(cacheHitPercent({ cacheRead: 1_999, input: 1 })).toBe('99.9')
+  })
+
+  it('trims a whole percentage and keeps one decimal otherwise', () => {
+    expect(cacheHitPercent({ cacheRead: 1, input: 1 })).toBe('50')
+    expect(cacheHitPercent({ cacheRead: 1, input: 2 })).toBe('33.3')
+  })
+
+  it('counts cache writes as prompt input', () => {
+    expect(cacheHitPercent({ cacheRead: 20, cacheWrite: 20 })).toBe('50')
+  })
+})
